# Base URL for the application
NEXT_PUBLIC_BASE_URL=https://your-domain.vercel.app

# Admin CMS API
KGNA_ADMIN_API_URL=https://kgna-admin.vercel.app

# Stripe API Keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs for Monthly Donations (optional - has defaults)
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY_10=price_monthly_10
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY_25=price_monthly_25
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY_50=price_monthly_50
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY_100=price_monthly_100

# Stripe Price IDs for Annual Donations (optional - has defaults)
NEXT_PUBLIC_STRIPE_PRICE_ANNUAL_100=price_annual_100
NEXT_PUBLIC_STRIPE_PRICE_ANNUAL_250=price_annual_250
NEXT_PUBLIC_STRIPE_PRICE_ANNUAL_500=price_annual_500
NEXT_PUBLIC_STRIPE_PRICE_ANNUAL_1000=price_annual_1000
